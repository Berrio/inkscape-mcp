{
  "name": "inkscape-mcp",
  "version": "0.1.0",
  "description": "MCP server for secure headless Inkscape document design and exports",
  "license": "MIT",
  "private": true,
  "mcpName": "io.github.berrio/inkscape-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Berrio/inkscape-mcp.git"
  },
  "homepage": "https://github.com/Berrio/inkscape-mcp#readme",
  "bugs": {
    "url": "https://github.com/Berrio/inkscape-mcp/issues"
  },
  "type": "module",
  "bin": {
    "inkscape-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "scripts/windows",
    "server.json",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11.0.0 <13"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "lint": "eslint src tests scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build --silent && vitest run",
    "test:unit": "npm test",
    "test:integration": "vitest run tests/integration",
    "test:cli": "npm run build --silent && node scripts/test-autonomous-cli.mjs",
    "test:windows": "npm run build --silent && node scripts/test-windows-automation.mjs",
    "test:mcp": "node scripts/test-mcp.mjs",
    "evidence:f03": "npm run build --silent && node scripts/generate-f03-preview-evidence.mjs",
    "test:f03-g08": "npm run build --silent && node scripts/test-f03-css-resize.mjs",
    "test:f03-g09": "npm run build --silent && node scripts/test-f03-page-settings.mjs",
    "inspect": "npx --no-install @modelcontextprotocol/inspector node dist/cli.js",
    "test:conformance": "npx --no-install @modelcontextprotocol/conformance",
    "pack:check": "npm pack --dry-run --json",
    "test:pack": "npm run build --silent && node scripts/pack-smoke.mjs",
    "release:provenance": "npm run build --silent && node scripts/release-provenance.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@xmldom/xmldom": "^0.9.12",
    "pdf-lib": "1.17.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/conformance": "0.1.16",
    "@modelcontextprotocol/inspector": "2.3.0",
    "@types/node": "26.3.0",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
